# syntax=docker/dockerfile:1

# --- Étape 1 : on installe les dépendances (jetable) ---
FROM node:22.11-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Le secret npmrc est monté en RAM le temps de ce RUN seulement
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc npm ci --omit=dev

# --- Étape 2 : l'image finale, qui ne garde que le nécessaire ---
FROM node:22.11-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node server.js db.js package.json ./

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

USER node
EXPOSE 3000
CMD ["node", "server.js"]
